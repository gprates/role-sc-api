      "modified": 1745712000000,
      "created": 1745712000000,
      "url": "{{ _.base_url }}/auth/register",
      "name": "POST /auth/register",
      "description": "Cria usuário com emailVerified=false, gera token hex de 32 bytes e dispara email via SES.\n\nResposta esperada (201):\n{\n  \"success\": true,\n  \"message\": \"Conta criada. Verifique seu email para ativar sua conta.\"\n}\n\nNão retorna JWT. O usuário precisa verificar o email antes de logar.",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"nome\": \"{{ _.test_nome }}\",\n  \"email\": \"{{ _.test_email }}\",\n  \"senha\": \"{{ _.test_password }}\"\n}"
      },
      "parameters": [],
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "x-api-key", "value": "{{ _.api_key }}" }
      ],
      "authentication": {},
      "metaSortKey": -1745712000100,
      "isPrivate": false,
      "pathParameters": [],
      "settingStoreCookies": true,
      "settingSendCookies": true,

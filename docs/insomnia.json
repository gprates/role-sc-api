      "url": "{{ _.base_url }}/auth/login",
      "name": "POST /auth/login",
      "description": "Autentica e retorna JWT + user. Exige emailVerified=true.\n\nRespostas:\n- 200: { success, token, user } ← outras requisições puxam o token daqui automaticamente\n- 401: credenciais inválidas\n- 403: { success: false, code: 'EMAIL_NOT_VERIFIED', message } ← email não verificado",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.test_email }}\",\n  \"senha\": \"{{ _.test_password }}\"\n}"

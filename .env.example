MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=role_sc
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# SES (AWS) — verificação de email
SES_FROM_EMAIL=seu-email-verificado@exemplo.com
SES_AWS_REGION=us-east-1

# Base URL pública usada para montar o link do email de verificação
# Em dev local: http://localhost:3000
# Em prod: https://<id>.execute-api.<region>.amazonaws.com/prod
APP_BASE_URL=http://localhost:3000

# S3 — bucket de avatares
S3_AVATARS_BUCKET=role-sc-avatars
S3_AVATARS_REGION=sa-east-1

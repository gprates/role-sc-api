MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=role_sc
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# SES (AWS) — verificação de email
SES_FROM_EMAIL=seu-email-verificado@exemplo.com
SES_AWS_REGION=us-east-1

# Base URL pública usada para montar o link do email de verificação
# Em dev local: http://localhost:3000
# Em prod: https://<id>.execute-api.<region>.amazonaws.com/prod
APP_BASE_URL=http://localhost:3000

# S3 — bucket de avatares
S3_AVATARS_BUCKET=role-sc-avatars
S3_AVATARS_REGION=sa-east-1

# Google Sign-In — Client IDs criados no Google Cloud Console.
# Backend valida o `audience` do id_token contra a UNIÃO de todos os clients
# configurados (qualquer um deve bater). Pode deixar em branco o que não usa.
#   - ANDROID Client ID: usado em APK próprio (prod, scheme rolesc://).
#     Mesmo valor que o frontend usa em EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID.
#   - WEB Client ID: usado em Expo Go (dev, via proxy auth.expo.io).
#     Mesmo valor que o frontend usa em EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID.
GOOGLE_ANDROID_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=000000000000-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy.apps.googleusercontent.com

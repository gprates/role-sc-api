# Copie para .env (`cp .env.example .env`). Os valores abaixo servem para
# rodar localmente; em produção eles vêm dos parâmetros do template.yaml.

# MongoDB (obrigatórias). Local: `docker run -d -p 27017:27017 mongo:7`
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=role_sc

# JWT (JWT_SECRET obrigatória; JWT_EXPIRES_IN tem padrão 7d)
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# SES (AWS): e-mails de verificação, código de recuperação e aviso de troca
# de senha. Sem credenciais AWS válidas o envio falha (o cadastro responde 500).
SES_FROM_EMAIL=nao-responda@exemplo.com
SES_AWS_REGION=us-east-1

# URL pública da própria API, usada no link do e-mail de verificação
# (<APP_BASE_URL>/auth/verify-email?token=...). Sem barra final.
APP_BASE_URL=http://localhost:3000

# S3: bucket e região dos avatares (POST /users/me/avatar/*)
S3_AVATARS_BUCKET=seu-bucket-de-avatares
S3_AVATARS_REGION=sa-east-1

# Google Sign-In (POST /auth/google): Client IDs do Google Cloud Console,
# aceitos como audience do id_token. Os mesmos valores usados pelo app
# (EXPO_PUBLIC_GOOGLE_*_CLIENT_ID) e pelo site (VITE_GOOGLE_WEB_CLIENT_ID).
# Vazios = login com Google desativado (a rota responde 500).
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Credenciais AWS não são lidas pelo código: o AWS SDK usa a cadeia padrão
# (variáveis AWS_*, ~/.aws, role da Lambda). Veja o README.
